{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Live-ish docs site, with a live copy of the starter deck on the same origin.",
  "license": "MIT",
  "scripts": {
    "generate": "tsx --conditions=react-server scripts/generate.ts",
    "dev": "pnpm generate && live-ish dev --port=3100",
    "build": "pnpm --filter @live-ish/engine build && pnpm generate && tsx scripts/build.ts",
    "start": "live-ish start --port=3100",
    "check:links": "tsx scripts/link-check.ts",
    "typecheck": "pnpm generate && live-ish prepare && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm generate && node --conditions=react-server --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@live-ish/engine": "workspace:*",
    "@mdx-js/mdx": "3.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
