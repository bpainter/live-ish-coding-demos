{
  "name": "live-ish-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Live-ish: scripted demos of code and UI, driven by a clicker.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpainter/live-ish-coding-demos.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scan:private": "node scripts/scan/private.mjs",
    "live-ish": "node packages/engine/bin/live-ish.mjs",
    "skills:ref": "node scripts/skills-ref.mjs",
    "skills:fresh": "node --import tsx scripts/skills-fresh.mts",
    "evals:claude": "node --import tsx scripts/skills-evals.mts",
    "build": "pnpm --filter starter exec next build",
    "build:conformance": "pnpm --filter conformance build",
    "test": "pnpm --filter @live-ish/engine test && pnpm --filter @live-ish/bridge test && pnpm --filter @live-ish/verify test && pnpm --filter docs test && node --test parity/*.test.mjs && node --import tsx --test scripts/test/*.test.mts",
    "test:contrast": "pnpm --filter @live-ish/engine test:contrast",
    "gen:themes": "pnpm --filter @live-ish/engine gen:themes",
    "typecheck": "pnpm prepare:decks && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "parity:docs": "node parity/render.mjs",
    "smoke": "node --import tsx scripts/smoke.mts",
    "export:walk": "node --import tsx scripts/export.mts",
    "hosting": "node --import tsx scripts/hosting.mts",
    "server": "node --import tsx scripts/server.mts",
    "test:e2e": "pnpm build && pnpm smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "gen:readme": "node --import tsx scripts/gen-readme.mts",
    "ci:pack": "node --import tsx scripts/ci/pack.mts",
    "ci:matrix": "node --import tsx scripts/ci/matrix.mts",
    "ci:capture": "node --import tsx scripts/ci/capture.mts",
    "ci:hosting": "node --import tsx scripts/ci/hosting.mts",
    "prepare:decks": "pnpm --filter starter exec live-ish prepare && pnpm --filter conformance exec live-ish prepare && pnpm --filter server exec live-ish prepare"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
