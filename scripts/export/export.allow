# Allow-list export. A path not named here does not cross.
# Format: <glob in the source repo> => <destination prefix>. "!" lines exclude.
# The source is read from one fixed commit with `git show`, so ignored files cannot cross.

app/layout.tsx => packages/engine/src/routes/_source/
app/page.tsx => packages/engine/src/routes/_source/
app/not-found.tsx => packages/engine/src/routes/_source/
app/sitemap.ts => packages/engine/src/routes/_source/
app/s/** => packages/engine/src/routes/_source/
app/present/** => packages/engine/src/routes/_source/
app/speaker/** => packages/engine/src/routes/_source/
app/robots.txt/** => packages/engine/src/routes/_source/
app/%5Fhealth/** => packages/engine/src/routes/_source/
app/demos/** => packages/engine/src/routes/_source/
app/fixtures/** => examples/conformance/_source/

components/stage/** => packages/engine/src/
components/chrome/** => packages/engine/src/
components/page/** => packages/engine/src/
components/presenter/** => packages/engine/src/
components/layouts/** => packages/engine/src/

content/schema.ts => packages/engine/src/schema/
content/demo-schema.ts => packages/engine/src/schema/
content/backgrounds.ts => packages/engine/src/schema/

lib/** => packages/engine/src/
!lib/validate/timing.ts
!lib/frames/wrappers/*
lib/frames/wrappers/types.ts => packages/engine/src/
lib/frames/wrappers/common.ts => packages/engine/src/
lib/frames/wrappers/index.ts => packages/engine/src/
lib/frames/wrappers/fixture-bare.ts => packages/engine/src/
lib/frames/wrappers/terminal-window.ts => packages/engine/src/

scripts/validate.mts => packages/engine/src/tasks/_source/
scripts/validator-fixtures.mts => packages/engine/src/tasks/_source/
scripts/settle-test.mts => packages/engine/src/tasks/_source/
scripts/support-test.mts => packages/engine/src/tasks/_source/
scripts/contrast-test.mts => packages/engine/src/tasks/_source/
scripts/asset-versions.mts => packages/engine/src/tasks/_source/
scripts/theme.mts => packages/engine/src/tasks/_source/
scripts/grain.mts => packages/engine/src/tasks/_source/
scripts/excerpt.mts => packages/engine/src/tasks/_source/
scripts/meters.mts => packages/engine/src/tasks/_source/
scripts/qr.mts => packages/engine/src/tasks/_source/
scripts/images.mts => packages/engine/src/tasks/_source/
scripts/fonts.mts => packages/engine/src/tasks/_source/
scripts/support-data.mts => packages/engine/src/tasks/_source/
scripts/record-terminal.mts => packages/engine/src/tasks/_source/
scripts/walk-demos.mts => packages/verify/src/_source/
scripts/walk-deck.mts => packages/verify/src/_source/
scripts/walk-spotlight.mts => packages/verify/src/_source/
scripts/walk-perf.mts => packages/verify/src/_source/
scripts/walk-a11y.mts => packages/verify/src/_source/
scripts/walk-wrapper.mts => packages/verify/src/_source/
scripts/walk-r7.mts => packages/verify/src/_source/
scripts/axe-frames.mts => packages/verify/src/_source/
scripts/capture.mts => packages/verify/src/_source/
scripts/visuals.mts => packages/verify/src/_source/
scripts/og.mts => packages/verify/src/_source/
scripts/warmup.mts => packages/verify/src/_source/
scripts/background-stats.mts => packages/verify/src/_source/
