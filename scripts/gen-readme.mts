/**
 * Writes the README's theme sentence from the theme files, so the two cannot disagree (RM-13).
 *
 *   node --import tsx scripts/gen-readme.mts           write
 *   node --import tsx scripts/gen-readme.mts --check   exit 1 on a difference
 */
import { execFileSync } from "node:child_process";
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const repo = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");
const file = path.join(repo, "README.md");
const cli = path.join(repo, "packages", "engine", "bin", "live-ish.mjs");
const { themes } = JSON.parse(execFileSync(process.execPath, [cli, "themes", "--json"], { cwd: path.join(repo, "examples", "starter"), encoding: "utf8" })) as { themes: { id: string; name: string }[] };

/** Theme names read as common nouns in a sentence, except the one that names a place. */
const inSentence = (name: string) => (name === "Swiss" ? name : name.toLowerCase());
const names = themes.map((t) => inSentence(t.name));
const list = `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;
const sentence = `Demo slides use one of ${themes.length} themes: ${list}. Set one for a deck, a demo or a page:`;

const START = "<!-- themes:start: generated by scripts/gen-readme.mts -->";
const END = "<!-- themes:end -->";
const before = readFileSync(file, "utf8");
const pattern = new RegExp(`${START.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}[\\s\\S]*?${END}`);
if (!pattern.test(before)) throw new Error("The README has no theme markers.");
// Blank lines around the sentence, because Prettier would add them.
const after = before.replace(pattern, `${START}\n\n${sentence}\n\n${END}`);

if (process.argv.includes("--check")) {
  if (after !== before) {
    console.error("The README's theme sentence is stale. Run node --import tsx scripts/gen-readme.mts.");
    process.exit(1);
  }
  console.log("README themes match the theme files.");
} else writeFileSync(file, after);
