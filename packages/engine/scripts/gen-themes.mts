/**
 * One source of truth for themes. Reads themes/<id>.json and the fixed palettes, and writes
 * everything derived from them:
 *
 *   assets/chrome/<id>.css, assets/chrome/<id>.frame.css   what the engine serves
 *   src/lib/chrome-themes.generated.ts                     the `ChromeThemeId` type and id list
 *   themes/chrome-theme.schema.json                        the JSON Schema of a theme file
 *   themes/chrome-theme-id.schema.json                     the enum for `chrome.theme`
 *   docs/generated/themes-table.md                         the table in the docs and README
 *   styles/deck/palette.generated.css                      the --deck-* palette
 *   styles/speaker/palette.generated.css                   the --speaker-* palette
 *
 *   pnpm --filter @live-ish/engine gen:themes           writes them
 *   pnpm --filter @live-ish/engine gen:themes --check   fails on any difference, for CI
 */
import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { CONTRACT_TOKENS, EFFECTS, listThemes, resolveTheme, themeCss, themeFrameCss } from "../src/lib/chrome-themes";
import { FONT_FAMILIES } from "../src/lib/fonts";
import { DECK_PALETTE, SPEAKER_PALETTE } from "../src/lib/palettes";

const ENGINE = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");
const REPO = path.join(ENGINE, "..", "..");
const CHECK = process.argv.includes("--check");

const themes = listThemes();
const outputs = new Map<string, string>();
const put = (file: string, text: string) => outputs.set(file, text);

for (const { id } of themes) {
  const theme = resolveTheme(id);
  put(path.join(ENGINE, "assets", "chrome", `${id}.css`), themeCss(theme));
  put(path.join(ENGINE, "assets", "chrome", `${id}.frame.css`), themeFrameCss(theme));
}

const ids = themes.map((t) => t.id);
const fonts = Object.fromEntries(themes.map((t) => [t.id, t.fonts]));
put(
  path.join(ENGINE, "src", "lib", "chrome-themes.generated.ts"),
  [
    "// Generated by packages/engine/scripts/gen-themes.mts from themes/*.json. Do not edit.",
    "",
    "/** Every built-in audience theme, the default first. */",
    `export const CHROME_THEME_IDS = ${JSON.stringify(ids)} as const;`,
    "",
    "export type ChromeThemeId = (typeof CHROME_THEME_IDS)[number];",
    "",
    "/** The theme a deck gets when it names none. */",
    `export const DEFAULT_CHROME_THEME: ChromeThemeId = ${JSON.stringify(ids[0])};`,
    "",
    "/** The font names each theme uses, for preloads and for copying only what a deck resolves to. */",
    `export const CHROME_THEME_FONTS: Record<ChromeThemeId, { sans: string; mono: string }> = ${JSON.stringify(fonts, null, 2)};`,
    "",
  ].join("\n"),
);

const color = { type: "string" };
put(
  path.join(ENGINE, "themes", "chrome-theme.schema.json"),
  JSON.stringify(
    {
      $schema: "https://json-schema.org/draft/2020-12/schema",
      title: "Live-ish chrome theme",
      type: "object",
      additionalProperties: false,
      required: ["schemaVersion", "id", "name"],
      properties: {
        $schema: { type: "string" },
        schemaVersion: { const: 1 },
        id: { type: "string", pattern: "^[a-z][a-z0-9-]*$" },
        name: { type: "string" },
        extends: { type: "string", description: "The theme that supplies what this file leaves out. Default: glass." },
        traits: { type: "array", items: { type: "string" } },
        tokens: {
          type: "object",
          additionalProperties: false,
          properties: Object.fromEntries(CONTRACT_TOKENS.filter((t) => !/code-(ink|keyword|string|comment|number|property)$|font-|dur-fade|chrome-effect/.test(t)).map((t) => [t, { type: "string" }])),
        },
        code: { type: "object", additionalProperties: false, properties: { ink: color, keyword: color, string: color, comment: color, number: color, property: color } },
        fonts: {
          type: "object",
          additionalProperties: false,
          properties: Object.fromEntries(["sans", "mono"].map((slot) => [slot, { oneOf: [{ type: "string" }, { type: "object", required: ["family", "files", "license"], properties: { family: { type: "string" }, license: { type: "string" }, files: { type: "array", items: { type: "object", properties: { src: { type: "string", pattern: "^/fonts/" }, weight: { type: "number" } } } } } }] }])),
        },
        motion: {
          type: "object",
          additionalProperties: false,
          properties: { fade: { type: "number", minimum: 0, maximum: 200 }, effect: { type: "string", description: `"none", or any of ${EFFECTS.join(", ")}, separated by spaces.` } },
        },
        details: { type: "object", additionalProperties: false, properties: { meter: { enum: ["counter"] }, title: { enum: ["glow"] }, rule: { enum: ["hairline"] } } },
      },
    },
    null,
    2,
  ) + "\n",
);
put(path.join(ENGINE, "themes", "chrome-theme-id.schema.json"), JSON.stringify({ $schema: "https://json-schema.org/draft/2020-12/schema", title: "Live-ish built-in chrome theme id", enum: ids }, null, 2) + "\n");

const license = (name: string) => (FONT_FAMILIES[name] ? "OFL 1.1" : "system");
const row = (t: (typeof themes)[number]) => {
  const fontCell = t.fonts.sans === t.fonts.mono ? `${t.fonts.sans} (${license(t.fonts.sans)})` : `${t.fonts.sans.replace(/"/g, "")}, ${t.fonts.mono.replace(/"/g, "")} (${license(t.fonts.sans)})`;
  return `| \`${t.id}\` | ${t.name} | ${t.traits.join(". ")}. | ${fontCell} | ${t.motion.fade} ms | ${t.motion.effect} |`;
};
put(path.join(REPO, "docs", "generated", "themes-table.md"), ["<!-- Generated by packages/engine/scripts/gen-themes.mts. Do not edit. -->", "", "| ID | Name | Traits | Fonts | Fade | Effect |", "|---|---|---|---|---|---|", ...themes.map(row), ""].join("\n"));

const palette = (selector: string, comment: string, tokens: Record<string, string>) => [`/* Generated from src/lib/palettes.ts by scripts/gen-themes.mts. ${comment} Do not edit. */`, `${selector} {`, ...Object.entries(tokens).map(([k, v]) => `  ${k}: ${v};`), "}", ""].join("\n");
put(path.join(ENGINE, "styles", "deck", "palette.generated.css"), palette(":root", "The copy slide palette.", DECK_PALETTE));
put(path.join(ENGINE, "styles", "speaker", "palette.generated.css"), palette(":root", "Presenter chrome: fixed, and out of any theme's reach.", SPEAKER_PALETTE));

const stale: string[] = [];
for (const [file, text] of outputs) {
  const current = existsSync(file) ? readFileSync(file, "utf8") : null;
  if (current === text) continue;
  if (CHECK) stale.push(path.relative(REPO, file));
  else {
    mkdirSync(path.dirname(file), { recursive: true });
    writeFileSync(file, text);
  }
}
// A theme removed from themes/ must not leave its CSS behind.
const known = new Set([...outputs.keys()]);
const chromeDir = path.join(ENGINE, "assets", "chrome");
if (existsSync(chromeDir)) for (const f of readdirSync(chromeDir)) if (!known.has(path.join(chromeDir, f))) stale.push(`assets/chrome/${f} (no theme file)`);

if (stale.length) {
  console.error(`gen:themes: ${stale.length} generated file(s) out of date:\n  ${stale.join("\n  ")}\nRun pnpm --filter @live-ish/engine gen:themes.`);
  process.exit(1);
}
const sizes = themes.map(({ id }) => outputs.get(path.join(ENGINE, "assets", "chrome", `${id}.css`))!.length);
console.log(`gen:themes: ${CHECK ? "checked" : "wrote"} ${outputs.size} files for ${themes.length} themes. Largest theme CSS ${Math.max(...sizes)} bytes.`);
