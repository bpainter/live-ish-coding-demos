{
  "$schema": "./chrome-theme.schema.json",
  "schemaVersion": 1,
  "id": "flat",
  "name": "Flat",
  "traits": [
    "Solid fills",
    "No shadow",
    "No blur",
    "One accent"
  ],
  "tokens": {
    "--chrome-backdrop": "#f4f4f2",
    "--chrome-backdrop-light": "#f4f4f2",
    "--chrome-backdrop-dark": "#f4f4f2",
    "--chrome-grain": "0",
    "--chrome-ink": "#1b1b1f",
    "--chrome-ink-soft": "#4a4a52",
    "--chrome-accent": "#b93a0a",
    "--chrome-title-weight": "700",
    "--chrome-card-surface": "#ffffff",
    "--chrome-card-border": "1px solid #dcdcd8",
    "--chrome-card-radius": "12px",
    "--chrome-card-shadow": "none",
    "--chrome-blur": "none",
    "--chrome-code-surface": "#ffffff",
    "--chrome-code-highlight-bg": "rgb(185 58 10 / 0.08)",
    "--chrome-code-highlight-bar": "#b93a0a",
    "--chrome-code-dim-opacity": "0.82",
    "--chrome-step-done": "#1b1b1f",
    "--chrome-step-current": "#b93a0a",
    "--chrome-step-future": "#85858b",
    "--chrome-spot-ring": "#b93a0a",
    "--chrome-spot-halo": "#ffffff",
    "--chrome-spot-width": "3px",
    "--chrome-spot-style": "solid",
    "--chrome-callout-bg": "#1b1b1f",
    "--chrome-callout-ink": "#ffffff",
    "--chrome-callout-leader": "#b93a0a",
    "--chrome-keycap-bg": "#1b1b1f",
    "--chrome-keycap-ink": "#ffffff",
    "--chrome-keycap-edge": "#1b1b1f",
    "--chrome-cursor": "#1b1b1f",
    "--term-bg": "#1b1b1f",
    "--term-ink": "#f4f4f2",
    "--term-prompt": "#ffb08a",
    "--term-comment": "#b8b8bf",
    "--term-chrome": "#2a2a30"
  },
  "code": {
    "ink": "#1b1b1f",
    "keyword": "#8f2f06",
    "string": "#13592e",
    "comment": "#4f4f57",
    "number": "#7a1f3d",
    "property": "#1e40af"
  },
  "fonts": {
    "sans": "Inter",
    "mono": "JetBrains Mono"
  },
  "motion": {
    "fade": 120,
    "effect": "none"
  }
}
