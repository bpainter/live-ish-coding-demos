import { readFile } from "node:fs/promises";
import { createServer } from "node:http";
import * as bridge from "@live-ish/bridge";

const page = new URL(
  "page.html",
  import.meta.url,
);

// The bridge gives a frame its script tag,
// the script and its headers. The one
// route this demo adds is /hello.
const routes = {
  "/hello": async () => [
    "application/json",
    JSON.stringify({ message: "Hello" }),
  ],
  "/": async () => [
    "text/html",
    String(await readFile(page)).replace(
      "<!-- bridge -->",
      bridge.runtimeTag(),
    ),
  ],
  "/live-ish-bridge.js": async () => [
    "text/javascript",
    bridge.bridgeScript(),
  ],
};

createServer(async (req, res) => {
  const path = req.url.split("?")[0];
  if (!routes[path]) {
    return res.writeHead(404).end();
  }
  const [type, body] = await routes[path]();
  const headers = bridge.frameHeaders();
  headers["Content-Type"] = type;
  res.writeHead(200, headers).end(body);
}).listen(process.env.PORT ?? {{port}});
