{
  "name": "@live-ish/engine",
  "version": "0.0.0",
  "description": "The Live-ish stage, presenter, reader, frame composer and runtime, consumed by a deck behind a thin Next.js shell.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpainter/live-ish-coding-demos.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "live-ish": "./bin/live-ish.mjs"
  },
  "exports": {
    "./config": "./src/schema/index.ts",
    "./next": {
      "types": "./src/next/with-deck.d.cts",
      "default": "./src/next/with-deck.cjs"
    },
    "./routes/*": "./src/routes/*.tsx",
    "./styles.css": "./dist/engine.css",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "shell",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build-css.mjs",
    "prepare": "node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "hast-util-to-jsx-runtime": "2.3.6",
    "lucide-react": "1.61.0",
    "qrcode": "1.5.4",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "tsx": "4.23.15",
    "web-features": "3.44.0"
  },
  "peerDependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
