{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@live-ish/deck": ["./.live-ish/deck.gen.ts"] }
  },
  "include": ["next-env.d.ts", "deck.config.ts", "slides/**/*.ts", "demos/*/demo.ts", "demos/*/routes.ts", "app/**/*", "next.config.ts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", ".next-present/types/**/*.ts", ".next-present/dev/types/**/*.ts", ".next-capture/types/**/*.ts", ".next-capture/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
