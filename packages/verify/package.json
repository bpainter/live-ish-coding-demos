{
  "name": "@live-ish/verify",
  "version": "0.0.0",
  "description": "Walks, accessibility scans, capture, warm-up and performance checks for Live-ish decks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpainter/live-ish-coding-demos.git",
    "directory": "packages/verify"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "live-ish-verify": "./bin/live-ish-verify.mjs"
  },
  "exports": {
    "./cli": "./src/cli.ts",
    "./budgets.json": "./budgets.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "budgets.json",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test test/*.test.ts",
    "selftest": "node --conditions=react-server --import tsx src/selftest.ts"
  },
  "dependencies": {
    "@playwright/test": "1.58.2",
    "axe-core": "4.14.0",
    "tsx": "4.23.15"
  },
  "peerDependencies": {
    "@live-ish/engine": "workspace:*"
  },
  "devDependencies": {
    "@live-ish/engine": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "next": "16.4.3",
    "typescript": "5.9.3"
  }
}
