{
  "name": "@live-ish/verify",
  "version": "0.1.0-next.0",
  "description": "Walks, accessibility scans, capture, warm-up, performance and parity checks for Live-ish decks. Ships Playwright, so a deck installs it on demand.",
  "license": "MIT",
  "homepage": "https://live-ish.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpainter/live-ish-coding-demos.git",
    "directory": "packages/verify"
  },
  "bugs": {
    "url": "https://github.com/bpainter/live-ish-coding-demos/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "live-ish-verify": "./bin/live-ish-verify.mjs"
  },
  "exports": {
    "./cli": "./src/cli.ts",
    "./parity": "./src/parity/index.ts",
    "./budgets.json": "./budgets.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "budgets.json",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test test/*.test.ts src/parity/*.test.ts",
    "test:parity": "node --conditions=react-server --import tsx --test src/parity/*.test.ts",
    "selftest": "node --conditions=react-server --import tsx src/selftest.ts"
  },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "tsx": "4.23.15"
  },
  "peerDependencies": {
    "@live-ish/engine": "workspace:*"
  },
  "devDependencies": {
    "@live-ish/engine": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "next": "16.4.3",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
